  "components": {
    "schemas": {
      "ApprovalBody": {
        "properties": {
          "order_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Order Id"
          }
        },
        "type": "object",
        "required": [
          "order_id"
        ],
        "title": "ApprovalBody"
      },
      "AssistantBody": {
        "properties": {
          "request_text": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 3,
            "title": "Request Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_text"
        ],
        "title": "AssistantBody"
      },
      "Constraints": {
        "properties": {
          "max_total_minor": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Total Minor"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          },
          "latest_arrival": {
            "type": "string",
            "format": "date",
            "title": "Latest Arrival"
          },
          "required_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Required Features"
          },
          "device": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "flexibility": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Flexibility"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "max_total_minor",
          "latest_arrival"
        ],
        "title": "Constraints"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinBody": {
        "properties": {
          "group_id": {
            "type": "string",
            "format": "uuid",
            "title": "Group Id"
          },
          "context": {
            "$ref": "#/components/schemas/ProductContext"
          },
          "accepted_terms": {
            "additionalProperties": true,
            "type": "object",
            "title": "Accepted Terms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "group_id",
          "context",
