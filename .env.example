# Hosted demos always use real PayPal sandbox; fixture mode is test-only.
RALLY_MODE=connected
DATABASE_URL=postgresql://coalition:coalition@localhost:5432/coalition
# A fresh schema preserves existing public tables and historical payment records.
RALLY_DATABASE_SCHEMA=rally
PUBLIC_URL=http://localhost:8000
# Server-side sandbox credentials. Never put secrets in VITE_* variables.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# G1 probe recipient only; must differ from the sending account.
PAYPAL_SHOP_EMAIL=
# V2 shop recipients: separate sandbox business accounts, never personal accounts.
PAYPAL_SHOP_EMAIL_DALBIT=
PAYPAL_SHOP_EMAIL_BADA=
PAYPAL_SHOP_EMAIL_HANEUL=
# Private workspace passwords; create strong values, never put in VITE_*.
RALLY_SHOP_PASSWORD_DALBIT=
RALLY_SHOP_PASSWORD_BADA=
RALLY_SHOP_PASSWORD_HANEUL=
RALLY_HUB_PASSWORD=
RALLY_JUDGE_PASSWORD=
# Opt-in scheduled fictional hub steps; enqueues genuine sandbox payouts/tracking.
RALLY_AUTO_FULFILLMENT=0
# Use an existing hosted structured-output model for the deployed demo.
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api-inference.bitdeer.ai
LLM_API_KEY=
LLM_MODEL=
# v3 bidding with Bitdeer AI: LLM_BASE_URL=https://api-inference.bitdeer.ai (model ids: GET /v1/models).
# Role models fall back to LLM_MODEL. Use json_object if the provider rejects json_schema.
LLM_MODEL_SHOP=
LLM_MODEL_BUYER=
LLM_RESPONSE_FORMAT=json_schema
# auction (v3 shop bidding) or exchange (v2 per-shop exchange).
RALLY_DEAL_MODE=auction
# Dev-only market snapshot (scripts/market_snapshot.py); never needed at runtime.
CHANNEL3_API_KEY=
# Optional private self-hosted development adapter only.
LLM_CONTAINER_BASE_URL=
OLLAMA_UPSTREAM=
# Empty for the single-origin Docker app; Render static hosting uses its API origin.
VITE_API_URL=
