COALITION_MODE=fixture
DATABASE_URL=postgresql://coalition:coalition@localhost:5432/coalition
PUBLIC_URL=http://localhost:8000
# Replace with a long random operator-only token, even for fixture mode.
OPERATOR_TOKEN=change-this-local-demo-token
# Sandbox checkout needs client ID, secret and merchant ID. Webhooks need their ID.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Single provider: Anthropic Messages API. Base URL and model are configurable.
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6
# The sandbox business merchant ID (not the REST client ID), checked before capture.
PAYPAL_MERCHANT_ID=
# Payments v2 current schema does not state retention. Default: reconcile unknown
# capture/refund responses, then require review rather than automatically replaying.
# Set ONLY after verifying the retention for this app and these endpoints with PayPal.
PAYPAL_PAYMENTS_RETRY_HOURS=0
# Optional static frontend -> API origin. Empty for local Vite proxy / Docker.
VITE_API_URL=
